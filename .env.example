# MizukiBot example environment
# Updated: 2026-06-21 17:15 +08:00
# Copy to .env and replace placeholder values. Do not commit real .env files.

# ===== Required model endpoint =====
# API_BASE_URL should point to an OpenAI-compatible /v1/chat/completions
# endpoint, Anthropic-compatible /v1/messages endpoint, or provider gateway.
API_BASE_URL=""
API_PROVIDER=""
API_KEY=placeholder
AI_MODEL=gemini-3-pro-preview
AI_TEMPERATURE=0.9
AI_TOP_P=0.92
AI_MAX_TOKENS=50000
AI_RETRIES=2
AI_STREAM_ENABLED=false
AI_STREAM_CHUNK_MS=900
AI_STREAM_FIRST_TOKEN_TIMEOUT_MS=240000
REQUEST_TIMEOUT_MS=60000
REQUEST_STREAM_TIMEOUT_MS=300000
# Set to false to disable the normal-user daily model call limit.
NORMAL_USER_MODEL_DAILY_LIMIT_ENABLED=true
NORMAL_USER_MODEL_DAILY_LIMIT=25
NORMAL_USER_MODEL_DAILY_LIMIT_STATE_FILE=""

# Independent private-chat proactive outreach. Model calls always use API_BASE_URL/API_KEY/AI_MODEL.
PRIVATE_PROACTIVE_ENABLED=true
PRIVATE_PROACTIVE_IDLE_MINUTES=120
PRIVATE_PROACTIVE_MIN_GAP_MINUTES=240
PRIVATE_PROACTIVE_MAX_PER_DAY=2
PRIVATE_PROACTIVE_SCAN_INTERVAL_MINUTES=10
PRIVATE_PROACTIVE_WINDOWS=09:00-15:00,17:00-23:00
PRIVATE_PROACTIVE_GLOBAL_MODEL_DAILY_LIMIT=50
PRIVATE_PROACTIVE_MAX_UNANSWERED_BATCHES=2

# QQ private-chat companion room. Runtime enable/disable state persists separately.
COMPANION_ROOM_ENABLED=false
COMPANION_ROOM_DEFAULT_DURATION_MINUTES=45
COMPANION_ROOM_SCAN_INTERVAL_MS=60000
COMPANION_ROOM_MODEL_TIMEOUT_MS=12000

# District-level weather warning subscriptions.
WEATHER_ALERT_ENABLED=false
WEATHER_ALERT_SCAN_TIMES=10:00,21:00
WEATHER_ALERT_STATE_FILE=""

# QQ private-chat email greeting subscriptions. Configure SMTP before enabling.
EMAIL_GREETING_ENABLED=false
EMAIL_GREETING_STATE_FILE=""
EMAIL_GREETING_SEND_TIME=09:00
EMAIL_GREETING_SCAN_INTERVAL_MS=600000
EMAIL_GREETING_VERIFICATION_TTL_MINUTES=15
EMAIL_GREETING_SMTP_HOST=""
EMAIL_GREETING_SMTP_PORT=587
EMAIL_GREETING_SMTP_SECURE=false
EMAIL_GREETING_SMTP_USER=""
EMAIL_GREETING_SMTP_PASS=""
EMAIL_GREETING_SMTP_FROM=""

# Optional fallback model. Keep disabled unless the fallback endpoint is verified.
AI_FALLBACK_ENABLED=false
AI_FALLBACK_MODEL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_BASE_URL=""
AI_FALLBACK_API_KEY=placeholder
AI_FALLBACK_FAILURE_THRESHOLD=3
AI_FALLBACK_COOLDOWN_MS=600000

# ===== Admin model override =====
ADMIN_USER_IDS=
ADMIN_API_BASE_URL=""
ADMIN_API_PROVIDER=""
ADMIN_API_KEY=placeholder
ADMIN_AI_MODEL=
ADMIN_IMAGE_MODEL=
ADMIN_AI_TEMPERATURE=
ADMIN_AI_TOP_P=
ADMIN_AI_MAX_TOKENS=""
ADMIN_AI_RETRIES=
ADMIN_AI_REASONING_EFFORT=
ADMIN_PRIVATE_MAIN_REPLY_STREAM_FIRST_TOKEN_TIMEOUT_MS=75000
ADMIN_PRIVATE_MAIN_REPLY_STREAM_TOTAL_TIMEOUT_MS=75000
ADMIN_AI_FALLBACK_ENABLED=false
ADMIN_AI_FALLBACK_MODEL=
ADMIN_AI_FALLBACK_PROVIDER=
ADMIN_AI_FALLBACK_API_BASE_URL=""
ADMIN_AI_FALLBACK_API_KEY=placeholder

# ===== Provider/protocol compatibility =====
OPENAI_MAIN_API_MODE=auto
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_PROMPT_CACHE_RETENTION=
OPENAI_PROMPT_CACHE_KEY_PREFIX=""
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BETA=
ANTHROPIC_PROMPT_CACHE_TTL=5m
ANTHROPIC_ADAPTIVE_THINKING_ENABLED=false
MODEL_TOP_P_ENABLED=false
MODEL_ENDPOINT_ALLOW_LOCAL_HTTP=false

# Browser-like TLS/JA3 impersonation for model HTTP calls.
MODEL_TLS_IMPERSONATION_ENABLED=true
MODEL_TLS_IMPERSONATION_CLIENT=chrome
MODEL_TLS_IMPERSONATION_STREAM_ENABLED=true
MODEL_TLS_IMPERSONATION_FALLBACK_ENABLED=true
MODEL_TLS_IMPERSONATION_CONNECTION_REUSE_ENABLED=false
MODEL_TLS_IMPERSONATION_FORCE_HTTP1=false
MODEL_TLS_IMPERSONATION_INSECURE_SKIP_VERIFY=false

# ===== NapCat / OneBot (HTTP only) =====
NAPCAT_ACTION_TIMEOUT_MS=30000
# NapCat 内部 sendMsg 等待 QQ 成功回调的超时；应小于上面的 HTTP 请求超时。
NAPCAT_MESSAGE_SEND_TIMEOUT_MS=25000

# Bot posts OneBot actions to NapCat over HTTP.
NAPCAT_HTTP_API_BASE_URL=placeholder
NAPCAT_HTTP_ACTION_SECRET=placeholder

# Render model-authored SVG/HTML to PNG and send it to the current QQ chat.
VISUAL_RENDER_ENABLED=false
VISUAL_RENDER_HTML_API_URL=placeholder
VISUAL_RENDER_TIMEOUT_MS=10000
# QQ 私聊主回复成功后，异步生成并补发瑞希状态栏图片；需要单独的 OpenAI 兼容端点。
PRIVATE_STATUS_BAR_ENABLED=false
PRIVATE_STATUS_BAR_API_BASE_URL=placeholder
PRIVATE_STATUS_BAR_API_KEY=placeholder
PRIVATE_STATUS_BAR_MODEL=placeholder
PRIVATE_STATUS_BAR_TIMEOUT_MS=8000
PRIVATE_STATUS_BAR_MAX_TOKENS=25000
# JSON threshold map. The highest threshold not greater than the current affection is selected.
PRIVATE_STATUS_BAR_IMAGE_URLS={"0":"D:/waifu/zhungtailan.jpg"}
SMALL_THEATER_ENABLED=false
SMALL_THEATER_MAX_INPUT_CHARS=4000
SMALL_THEATER_MEMORY_TOP_K=8
SMALL_THEATER_MODEL_TIMEOUT_MS=60000
SMALL_THEATER_COOLDOWN_MS=15000
SMALL_THEATER_FAILURE_RETRY_COOLDOWN_MS=5000
SMALL_THEATER_MAX_CONCURRENCY=2

# HTTP reverse ingress: configure NapCat onebot11 postUrls to
# http://127.0.0.1:3002 and use the same secret above.
NAPCAT_HTTP_REVERSE_PORT=3002
NAPCAT_HTTP_REVERSE_BIND_HOST=127.0.0.1
NAPCAT_HTTP_REVERSE_ENABLED=true
NAPCAT_HTTP_REVERSE_ALLOW_LEGACY_BEARER=false
NAPCAT_HTTP_REVERSE_SECRET=changeme

# HMAC key for user/group/message identifiers written to request-trace and model-calls logs.
# Keep it secret and stable across bot processes when cross-process correlation is needed.
REQUEST_TRACE_HASH_SECRET=changeme
BOT_QQ=
FOLLOWER_PACKET_LOG_ENABLED=false
QQ_THINKING_EMOJI_IDS=355
QQ_THINKING_EMOJI_TIMEOUT_MS=3000
QQ_SAFETY_RESTRICTION_EMOJI_IDS=39

# ===== Web panel =====
WEB_PORT=3005
WEB_BIND_HOST=127.0.0.1
WEB_REQUIRE_HTTPS=true
WEB_TOKEN=placeholder
WEB_LOCAL_ONLY_WITHOUT_TOKEN=true
WEB_TRUST_PROXY_HOPS=0
WEB_SESSION_TTL_MS=900000
WEB_SESSION_MAX_ACTIVE=128
WEB_LOGIN_RATE_LIMIT_WINDOW_MS=300000
