# Optional env vars for native skills that still rely on external providers.
# Copy only the keys you need into .env and keep real secrets out of git.

# skill_image_generate_pro
# Preferred dedicated key. If omitted, the skill will also reuse
# BOT_DIARY_QZONE_IMAGE_PROVIDER_API_KEY when that provider is already configured.
GEMINI_API_KEY=placeholder

# skill_ppt_generate / skill_ppt_theme_list
# API key used as Bearer token when calling your own PPT HTTP adapter.
BAIDU_API_KEY=placeholder
# Your PPT adapter endpoint. The current native skill expects a POST JSON API.
BAIDU_PPT_API_URL=

# skill_youtube_transcript
# HTTP endpoint that accepts ?videoId=... and returns transcript text/XML/JSON.
YOUTUBE_TRANSCRIPT_PROVIDER_URL=

# Optional market data fallbacks already supported by native stock skills.
TWELVEDATA_API_KEY=placeholder
ALPHAVANTAGE_API_KEY=placeholder

# Local command bridge hardening
# Keep real values in .env only. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If omitted, bridge health checks still work but command execution is blocked.
LOCAL_COMMAND_BRIDGE_TOKEN=placeholder
# Optional token forwarded to local HAPI CLI calls. Do not hard-code it in code.
CLI_API_TOKEN=placeholder

# Web console hardening
# If omitted, the console keeps localhost-only compatibility mode and prints a warning.
WEB_TOKEN=placeholder

# My Coffee / 瑞希瑞幸
# Global token is only used for low-risk Luckin menu/shop/product/preview calls.
# Users must provide their own temporary token in private chat for order creation.
LUCKIN_MCP_GLOBAL_TOKEN=placeholder
LUCKIN_MCP_TOKEN=placeholder
LUCKIN_MCP_ENDPOINT=https://gwmcp.lkcoffee.com/order/user/mcp
LUCKIN_USER_RATE_LIMIT_WINDOW_MS=60000
LUCKIN_USER_RATE_LIMIT_MAX=12
# Optional raw OneBot/NapCat message payload for the official mini app card.
# If omitted or sending fails, 瑞希瑞幸 still replies with text guidance.
LUCKIN_MINIAPP_CARD_PAYLOAD=

# Humanizer sub-agent
# Optional dedicated endpoint/key/model for de-AI rewriting and semantic stream chunking.
# Leave URL/key/model empty to fall back to the main model config.
HUMANIZER_AGENT_ENABLED=true
HUMANIZER_AGENT_API_BASE_URL=""
HUMANIZER_AGENT_API_KEY=placeholder
HUMANIZER_AGENT_MODEL=
HUMANIZER_AGENT_FIRST_TOKEN_TIMEOUT_MS=10000

# Read-only security diagnostics
# Run with: npm run diag:security
# JSON output for automation: node scripts/diagnose-security.js --json
