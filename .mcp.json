{
  "mcpServers": {
    "fetch": {
      "command": "node",
      "args": [
        "scripts/local-mcp-server.js",
        "fetch"
      ]
    },
    "amap-maps": {
      "command": "node",
      "args": [
        "scripts/local-mcp-server.js",
        "amap-maps"
      ]
    },
    "bing-search": {
      "command": "node",
      "args": [
        "scripts/local-mcp-server.js",
        "bing-search"
      ]
    },
    "howtocook-mcp": {
      "command": "node",
      "args": [
        "scripts/local-mcp-server.js",
        "howtocook-mcp"
      ]
    },
    "memos-api-mcp": {
      "command": "node",
      "protocolMode": "line",
      "args": [
        "node_modules/@memtensor/memos-api-mcp/build/index.js"
      ],
      "env": {
        "MEMOS_API_KEY": "${MEMOS_API_KEY}",
        "MEMOS_USER_ID": "${MEMOS_USER_ID}",
        "MEMOS_CHANNEL": "MODELSCOPE"
      }
    },
    "my-coffee": {
      "type": "streamablehttp",
      "url": "https://gwmcp.lkcoffee.com/order/user/mcp",
      "headers": {
        "Authorization": "Bearer ${LUCKIN_MCP_GLOBAL_TOKEN}"
      }
    }
  }
}
